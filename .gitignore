# Build output
build/
bin/
debug/
*.o
*.d
*.elf
*.hex
*.map
*.asm
*.apdu
*.sha256

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
myenv/
venv/
.venv/

# Ragger / Speculos test artifacts
tests/**/snapshots-tmp/
tests/**/.pytest_cache/

# JS functional tests
js/node_modules/
# ...but the DKG restore-share fixture is a required test input, not build
# output. The *.hex rule above (for app.hex) would otherwise swallow it.
!js/test/fixtures/*.hex

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
