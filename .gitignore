# Build output
build/
bin/
debug/
*.o
*.d
*.elf
*.hex
*.map
*.asm
*.apdu
*.sha256

# ...except the staged per-device release binaries (sw/prod/frost-0), which
# other repos consume directly: build/<device>/bin/app.{elf,apdu}.
!/build/
/build/*
!/build/*/
/build/*/*
!/build/*/bin/
/build/*/bin/*
!/build/*/bin/app.elf
!/build/*/bin/app.apdu

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
myenv/
venv/
.venv/

# Ragger / Speculos test artifacts
tests/**/snapshots-tmp/
tests/**/.pytest_cache/

# JS functional tests
js/node_modules/
# ...but the DKG restore-share fixture is a required test input, not build
# output. The *.hex rule above (for app.hex) would otherwise swallow it.
!js/test/fixtures/*.hex

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
rs/target/

!/build/toolchain.txt
!/build/prod/
/build/prod/*
!/build/prod/*/
/build/prod/*/*
!/build/prod/*/app.elf
!/build/prod/*/app.apdu
!/build/prod/*/artifact-manifest.txt
!/build/dev/
/build/dev/*
!/build/dev/*/
/build/dev/*/*
!/build/dev/*/app.elf
!/build/dev/*/app.apdu
!/build/dev/*/artifact-manifest.txt
